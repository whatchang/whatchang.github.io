---
import { profile } from "../data/profile";
import About from "./About.astro";
import SocialIcons from "./SocialIcons.astro";
import { withBase } from "../lib/url";
---

<section id="top" aria-labelledby="profile-name" class="border-b border-zinc-200 bg-zinc-50/70 dark:border-zinc-800 dark:bg-zinc-900/40">
  <div id="about" class="profile-grid mx-auto max-w-3xl items-start gap-x-5 gap-y-5 px-6 py-10 sm:gap-x-10 sm:py-14">
    <header class="identity">
      <h1 id="profile-name" class="font-display text-3xl leading-tight tracking-tight sm:text-6xl">
        {profile.nameEn}
      </h1>
      <p lang="ko" class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{profile.nameKo}</p>
    </header>
    <div class="affiliation">
      <p class="font-medium">{profile.title}</p>
      <p class="mt-1 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">{profile.affiliation}</p>
      {profile.advisor.name && (
        <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">
          Advisor: {profile.advisor.href
            ? <a href={profile.advisor.href} class="text-indigo-700 hover:underline dark:text-indigo-300">{profile.advisor.name}</a>
            : profile.advisor.name}
        </p>
      )}
    </div>
    <img
      src={withBase("/images/profile.png")}
      alt={`Portrait of ${profile.nameEn}`}
      width="413"
      height="531"
      class="portrait h-auto w-16 rounded-lg border border-zinc-200 sm:w-40 dark:border-zinc-700"
    />
    <div class="bio"><About /></div>
    <div class="contacts"><SocialIcons links={profile.links} email={profile.email} showLabels /></div>
  </div>
</section>

<style>
  .profile-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: "identity portrait" "affiliation affiliation" "bio bio" "contacts contacts";
  }
  .identity { grid-area: identity; }
  .affiliation { grid-area: affiliation; }
  .portrait { grid-area: portrait; }
  .bio { grid-area: bio; }
  .contacts { grid-area: contacts; }
  @media (min-width: 40rem) {
    .profile-grid { grid-template-areas: "identity portrait" "affiliation portrait" "bio portrait" "contacts contacts"; }
  }
</style>
