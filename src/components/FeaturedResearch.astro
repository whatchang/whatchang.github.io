---
import { featured } from "../data/featured";
import { orderedResearchLinks } from "../data/research-link";
import LinkChip from "./LinkChip.astro";
import { withBase } from "../lib/url";
---

<section id="featured" aria-labelledby="projects-title" class="mx-auto max-w-3xl px-6 pt-12 pb-6">
  <h2 id="projects-title" class="text-2xl font-semibold tracking-tight md:text-3xl">Research projects</h2>
  <div class="mt-6 grid gap-x-6 gap-y-8 sm:grid-cols-2">
    {featured.map((item) => (
      <article class="flex min-w-0 flex-col border-t-2 border-indigo-200 pt-4 dark:border-indigo-900">
        {item.figure && (
          <div class="mb-4 flex aspect-[2.5] items-center justify-center overflow-hidden rounded-md border border-zinc-200 bg-white p-2 dark:border-zinc-700">
            <img src={withBase(item.figure.src)} alt={item.figure.alt} loading="lazy" class="h-full w-full object-contain" />
          </div>
        )}
        <p class="text-sm font-medium text-indigo-700 dark:text-indigo-300">{item.status}</p>
        <h3 class="mt-2 text-lg font-semibold leading-snug tracking-tight">{item.title}</h3>
        <dl class="mt-4 space-y-4">
          <div>
            <dt class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Research goal</dt>
            <dd class="mt-1 leading-relaxed text-zinc-700 dark:text-zinc-300">{item.goal}</dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">My contribution</dt>
            <dd class="mt-1 leading-relaxed text-zinc-700 dark:text-zinc-300">{item.contribution}</dd>
          </div>
        </dl>
        {item.links && (
          <div class="mt-auto flex flex-wrap gap-2 pt-4">
            {orderedResearchLinks(item.links).map((link) => <LinkChip {...link} />)}
          </div>
        )}
      </article>
    ))}
  </div>
</section>
