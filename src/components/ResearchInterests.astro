---
import { interests } from "../data/interests";
---
<section id="research" class="mx-auto max-w-3xl px-6 pt-12">
  <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Research interests</h2>
  <dl class="mt-6 space-y-5">
    {interests.map((item) => (
      <div class="border-l-2 border-indigo-200 pl-4 dark:border-indigo-900">
        <dt class="font-semibold">{item.text}</dt>
        <dd class="mt-1 max-w-prose leading-relaxed text-zinc-700 dark:text-zinc-300">{item.detail}</dd>
      </div>
    ))}
  </dl>
</section>
