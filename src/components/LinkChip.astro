---
import type { ResearchLink } from "../data/research-link";

type Props = ResearchLink;
const { kind, href, label = kind } = Astro.props;
const external = /^https?:\/\//.test(href);

const colors = {
  Paper:
    "border-blue-200 bg-blue-50 text-blue-800 hover:bg-blue-100 dark:border-blue-800 dark:bg-blue-950 dark:text-blue-200 dark:hover:bg-blue-900",
  Code:
    "border-emerald-200 bg-emerald-50 text-emerald-800 hover:bg-emerald-100 dark:border-emerald-800 dark:bg-emerald-950 dark:text-emerald-200 dark:hover:bg-emerald-900",
  Project:
    "border-amber-200 bg-amber-50 text-amber-800 hover:bg-amber-100 dark:border-amber-800 dark:bg-amber-950 dark:text-amber-200 dark:hover:bg-amber-900",
} satisfies Record<ResearchLink["kind"], string>;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class:list={["inline-flex items-center rounded-full border px-3 py-1 text-xs font-medium transition-colors", colors[kind]]}
>
  {label}
</a>
