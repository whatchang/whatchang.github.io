---
import { publications, SELF_NAMES } from "../data/publications";
import { orderedResearchLinks } from "../data/research-link";
import LinkChip from "./LinkChip.astro";

const years = [...new Set(publications.map((pub) => pub.year))].sort(
  (a, b) => b - a,
);
---

<section id="publications" class="mx-auto max-w-3xl px-6 pt-12 pb-6">
  <h2
    class="text-2xl font-semibold tracking-tight text-zinc-900 md:text-3xl dark:text-zinc-100"
  >
    Publications
  </h2>
  <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
    * Equal contribution.
  </p>

  <div class="mt-8 space-y-9">
    {
      years.map((year) => (
        <div class="border-t border-zinc-200 pt-5 sm:grid sm:grid-cols-[3.5rem_minmax(0,1fr)] sm:gap-5 dark:border-zinc-800">
          <h3 class="font-mono text-sm font-medium tabular-nums text-zinc-500 sm:pt-0.5 dark:text-zinc-400">
            {year}
          </h3>
          <ul class="mt-4 space-y-8 sm:mt-0">
            {publications.filter((pub) => pub.year === year).map((pub) => (
              <li>
                <h4 class="text-base font-semibold leading-snug text-zinc-900 dark:text-zinc-100">
                  {pub.title}
                </h4>
                <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                  {pub.authors.map((author, index) => {
                    const isSelf = SELF_NAMES.includes(author);
                    const equalContributor = index < (pub.equalContribution ?? 0);
                    return (
                      <>
                        <span class:list={[isSelf && "font-semibold text-zinc-900 dark:text-zinc-100"]}>
                          {author}{equalContributor && "*"}
                        </span>
                        {index < pub.authors.length - 1 ? ", " : ""}
                      </>
                    );
                  })}
                </p>
                <p class="mt-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
                  {pub.venue}
                </p>
                <div class="mt-3 flex flex-wrap gap-2">
                  {orderedResearchLinks(pub.links).map((link) => (
                    <LinkChip {...link} />
                  ))}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
